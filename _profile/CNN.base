filters:
  and:
    - profile == "CNN"
views:
  - type: table
    name: Tickets Not Closed
    filters:
      and:
        - status != "Closed"
    groupBy:
      property: tags
      direction: ASC
    order:
      - file.name
      - priority
      - status
      - tags
      - assignee
    sort:
      - property: status
        direction: DESC
    rowHeight: medium
    columnSize:
      file.name: 384
      note.tags: 237
      note.assignee: 150
