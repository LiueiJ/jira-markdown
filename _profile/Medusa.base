filters:
  and:
    - profile == "Medusa"
views:
  - type: table
    name: Tickets
    groupBy:
      property: status
      direction: ASC
    order:
      - file.basename
      - assignee
      - status
      - updated
      - jira_url
    sort:
      - property: assignee
        direction: ASC
      - property: summary
        direction: ASC
      - property: jira_key
        direction: DESC
      - property: status
        direction: DESC
    columnSize:
      file.basename: 466
