filters:
  and:
    - profile == "CN Motivation"
views:
  - type: table
    name: Tickets
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - status
      - assignee
    columnSize:
      file.name: 359
      note.status: 83
      note.assignee: 384
    rowHeight: medium
