filters:
  and:
    - profile == "CEA2.0 Needs"
views:
  - type: table
    name: Tickets
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - priority
      - status
      - assignee
      - jira_url
      - tags
    sort:
      - property: file.basename
        direction: DESC
      - property: priority
        direction: ASC
    columnSize:
      file.basename: 383
      note.assignee: 114
      note.jira_url: 54
      note.tags: 466
    rowHeight: medium
